<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Link</title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>
<body>

    <%- include("../partials/navbar") %>

    <section class="section">

        <div class="container">

            <!-- CATEGORY SEARCH -->

            <form action="/content/mine" method="GET" class="mb-5">

                <div class="field has-addons">

                    <div class="control is-expanded">

                        <div class="select is-fullwidth">

                            <select name="category">

                                <option value="">
                                    All Categories
                                </option>

                                <option
                                    value="1"
                                    <%= categoryId === "1" ? "selected" : "" %>
                                >
                                    Education
                                </option>

                                <option
                                    value="2"
                                    <%= categoryId === "2" ? "selected" : "" %>
                                >
                                    Humor
                                </option>

                                <option
                                    value="3"
                                    <%= categoryId === "3" ? "selected" : "" %>
                                >
                                    Technology
                                </option>

                                <option
                                    value="4"
                                    <%= categoryId === "4" ? "selected" : "" %>
                                >
                                    Entertainment
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="control">

                        <button
                            class="button is-info"
                            type="submit"
                        >
                            Search
                        </button>

                    </div>

                    <% if (categoryId) { %>

                        <div class="control">

                            <a
                                class="button is-light"
                                href="/content/mine"
                            >
                                Clear
                            </a>

                        </div>

                    <% } %>

                </div>

            </form>


            <% if (content.length === 0) { %>

                <div class="notification is-light has-text-centered">

                    <% if (categoryId) { %>

                        You don't have any content in this category.

                    <% } else { %>

                        You haven't created any content yet.

                    <% } %>

                </div>

            <% } else { %>

                <div class="content-feed">

                    <% content.forEach(item => { %>

                        <article class="card content-card">


                            <!-- TITLE -->

                            <header class="card-header">

                                <p class="card-header-title">
                                    <%= item.title %>
                                </p>

                            </header>


                            <!-- TEXT -->

                            <% if (item.content_type === "text") { %>

                                <div class="card-content">

                                    <div class="text-post">
                                        <%= item.text_body %>
                                    </div>

                                </div>

                            <% } %>


                            <!-- IMAGE -->

                            <% if (item.content_type === "image") { %>

                                <div class="card-image">

                                    <figure class="image">

                                        <img
                                            src="<%= item.image_url %>"
                                            alt="<%= item.alt_text || item.title %>"
                                        >

                                    </figure>

                                </div>

                            <% } %>


                            <!-- REDIRECT -->

                            <% if (item.content_type === "redirect") { %>

                                <div class="card-content">

                                    <p>
                                        <strong>
                                            Destination:
                                        </strong>
                                    </p>

                                    <div class="text-post">
                                        <%= item.destination_url %>
                                    </div>

                                </div>

                            <% } %>


                            <!-- CATEGORY FOOTER -->

                            <% if (item.categories && item.categories.length > 0) { %>

                                <footer class="content-card-footer">
                                    <div class="tags are-small">
                                        <% item.categories.forEach(category => { %>

                                            <% let categoryColor = "is-light"; %>

                                            <% if (category === "Education") { %>
                                                <% categoryColor = "is-info"; %>

                                            <% } else if (category === "Humor") { %>
                                                <% categoryColor = "is-warning"; %>

                                            <% } else if (category === "Technology") { %>
                                                <% categoryColor = "is-success"; %>

                                            <% } else if (category === "Entertainment") { %>
                                                <% categoryColor = "is-danger"; %>
                                            <% } %>

                                            <span class="tag <%= categoryColor %>">
                                                <%= category %>
                                            </span>

                                        <% }) %>

                                    </div>

                                </footer>

                            <% } %>


                            <!-- MANAGEMENT CONTROLS -->

                            <div class="card-content card-management-controls">
                                <div class="buttons content-buttons">

                                    <!-- EDIT -->

                                    <a
                                        class="button is-info is-light"
                                        href="/content/<%= item.content_id %>/edit"
                                    >
                                        Edit
                                    </a>


                                    <!-- DELETE -->

                                    <button
                                        class="button is-danger is-light delete-button"
                                        type="button"
                                        data-content-id="<%= item.content_id %>"
                                        data-content-title="<%= item.title || 'Untitled' %>"
                                    >
                                        Delete
                                    </button>

                                </div>

                            </div>


                        </article>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </section>


    <!-- ==========================================
         DELETE CONFIRMATION MODAL
         ========================================== -->

    <div
        class="modal"
        id="delete-modal"
    >

        <div class="modal-background"></div>


        <div class="modal-card">


            <!-- MODAL HEADER -->

            <header class="modal-card-head">

                <p class="modal-card-title">
                    Delete Content
                </p>

                <button
                    class="delete"
                    id="close-delete-modal"
                    aria-label="close"
                    type="button"
                ></button>

            </header>


            <!-- MODAL BODY -->

            <section class="modal-card-body">

                <p class="mt-3">
                    Are you sure you want to delete this content?
                    <strong id="delete-content-title"></strong>
                </p>

                <p class="mt-3">
                    This action cannot be undone.
                </p>

            </section>


            <!-- MODAL FOOTER -->

            <footer class="modal-card-foot modal-buttons">
               
                <!-- YES -->
                
                <form
                    id="delete-form"
                    method="POST"
                >

                    <button
                        class="button is-danger modal-button"
                        type="submit"
                    >
                        Yes
                    </button>

                </form>


                <!-- NO -->

                <button
                    class="button modal-button"
                    id="cancel-delete"
                    type="button"
                >
                    No
                </button>
               
                
            </footer>

        </div>

    </div>


    <!-- ==========================================
         DELETE MODAL JAVASCRIPT
         ========================================== -->

    <script>

        const modal =
            document.getElementById("delete-modal");

        const deleteButtons =
            document.querySelectorAll(".delete-button");

        const deleteForm =
            document.getElementById("delete-form");

        const contentTitle =
            document.getElementById(
                "delete-content-title"
            );

        const closeButton =
            document.getElementById(
                "close-delete-modal"
            );

        const cancelButton =
            document.getElementById(
                "cancel-delete"
            );

        const modalBackground =
            modal.querySelector(".modal-background");


        // ==========================================
        // OPEN MODAL
        // ==========================================

        deleteButtons.forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    const contentId =
                        button.dataset.contentId;

                    const title =
                        button.dataset.contentTitle;


                    // Show content title
                    contentTitle.textContent =
                        title;


                    // Set deletion route
                    deleteForm.action =
                        `/content/${contentId}/delete`;


                    // Open modal
                    modal.classList.add(
                        "is-active"
                    );

                }
            );

        });


        // ==========================================
        // CLOSE MODAL
        // ==========================================

        function closeModal() {

            modal.classList.remove(
                "is-active"
            );

            deleteForm.action = "";

            contentTitle.textContent = "";

        }


        // X button
        closeButton.addEventListener(
            "click",
            closeModal
        );


        // No button
        cancelButton.addEventListener(
            "click",
            closeModal
        );


        // Click outside modal
        modalBackground.addEventListener(
            "click",
            closeModal
        );


        // Escape key
        document.addEventListener(
            "keydown",
            event => {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("is-active")
                ) {

                    closeModal();

                }

            }
        );

    </script>

    <%- include("../partials/footer") %>

    </body>
</html>