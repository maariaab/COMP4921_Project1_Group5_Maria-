<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Link</title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <%- include("../partials/navbar") %>

        <section class="section browse-section">

            <form action="/content" method="GET" class="mb-5">

            <div class="field has-addons">

                <div class="control is-expanded">

                    <input
                        class="input"
                        type="text"
                        name="search"
                        placeholder="Search content by title..."
                        value="<%= search || '' %>"
                    >

                </div>

                <div class="control">

                    <button
                        class="button is-info"
                        type="submit"
                    >
                        Search
                    </button>

                </div>

                <% if (search) { %>

                    <div class="control">

                        <a
                            class="button is-light"
                            href="/content"
                        >
                            Clear
                        </a>

                    </div>

                <% } %>

            </div>

        </form>

            <div class="container">

                <!-- CATEGORY FILTER BAR -->

                <div class="tabs is-centered category-tabs">

                    <ul>

                        <li class="<%= !categoryId ? 'is-active' : '' %>">
                            <a href="/content?search=<%= encodeURIComponent(search || '') %>">
                                All
                            </a>
                        </li>

                        <li class="<%= categoryId === '1' ? 'is-active' : '' %>">
                            <a href="/content?category=1&search=<%= encodeURIComponent(search || '') %>">
                                Education
                            </a>
                        </li>

                        <li class="<%= categoryId === '2' ? 'is-active' : '' %>">
                            <a href="/content?category=2&search=<%= encodeURIComponent(search || '') %>">
                                Humor
                            </a>
                        </li>

                        <li class="<%= categoryId === '3' ? 'is-active' : '' %>">
                            <a href="/content?category=3&search=<%= encodeURIComponent(search || '') %>">
                                Technology
                            </a>
                        </li>

                        <li class="<%= categoryId === '4' ? 'is-active' : '' %>">
                            <a href="/content?category=4&search=<%= encodeURIComponent(search || '') %>">
                                Entertainment
                            </a>
                        </li>

                    </ul>

                </div>

                <% if (content.length === 0) { %>

                        <div class="notification is-light has-text-centered">
                            No content has been posted yet.
                        </div>

                    <% } %>



                <div class="content-feed">

                    


                    <% content.forEach(item => { %>

                        <article class="card content-card">

                            <!-- TITLE -->

                            <header class="card-header">

                                <p class="card-header-title">
                                    <%= item.title %>
                                </p>

                            </header>


                            <!-- TEXT -->

                            <% if (item.content_type === "text") { %>

                                <div class="card-content">

                                    <div class="text-post">
                                        <%= item.text_body %>
                                    </div>

                                </div>

                            <% } %>


                            <!-- IMAGE -->

                            <% if (item.content_type === "image") { %>

                                <div class="card-image">

                                    <figure class="image">

                                        <img
                                            src="<%= item.image_url %>"
                                            alt="<%= item.alt_text || item.title %>"
                                        >

                                    </figure>

                                </div>

                            <% } %>

                            <% if (item.content_type === "redirect") { %>

                                <div class="card-content">

                                <div class="text-post">

                                
                                    <a
                                        href="/c/<%= item.content_id %>"
                                        class="browse-redirect-link"
                                    >
                                        <%= baseUrl %>/c/<%= item.content_id %>
                                    </a>

                                </div>

                            </div>

                            
                        <% } %>

                        <% if (item.categories && item.categories.length > 0) { %>

                            <footer class="content-card-footer">
                                <div class="tags are-small">
                                    <% item.categories.forEach(category => { %>

                                        <% let categoryColor = "is-light"; %>

                                        <% if (category === "Education") { %>
                                            <% categoryColor = "is-info"; %>

                                        <% } else if (category === "Humor") { %>
                                            <% categoryColor = "is-warning"; %>

                                        <% } else if (category === "Technology") { %>
                                            <% categoryColor = "is-success"; %>

                                        <% } else if (category === "Entertainment") { %>
                                            <% categoryColor = "is-danger"; %>
                                        <% } %>

                                        <span class="tag <%= categoryColor %>">
                                            <%= category %>
                                        </span>

                                    <% }) %>

                                </div>

                            </footer>

                        <% } %>

                                
                        </article>

                    <% }) %>

                </div>

            </div>

        </section>


        <!-- REDIRECT CONFIRMATION MODAL -->

        <div class="modal" id="browseRedirectModal">

            <div class="modal-background"></div>

            <div class="modal-card">

                <header class="modal-card-head">
                    <p class="modal-card-title">
                        Leaving This Page
                    </p>
                </header>

                <section class="modal-card-body has-text-centered">

                    <p class="mb-3">
                        You will be redirected in
                        <strong>
                            <span id="browseRedirectCountdown">5</span>
                        </strong>
                        seconds.
                    </p>

                    <p class="has-text-grey">
                        Would you like to continue immediately?
                    </p>

                </section>

                <footer class="modal-card-foot">

                    <button
                        type="button"
                        class="button is-danger"
                        id="browseRedirectNow"
                    >
                        Go Now
                    </button>

                    <button
                        type="button"
                        class="button is-light"
                        id="browseRedirectCancel"
                    >
                        Go Back
                    </button>

                </footer>

            </div>

        </div>


        <script>
            document.addEventListener("DOMContentLoaded", () => {

                const modal = document.getElementById("browseRedirectModal");

                const redirectLinks = document.querySelectorAll(
                    ".browse-redirect-link"
                );

                const countdownElement = document.getElementById(
                    "browseRedirectCountdown"
                );

                const goNowButton = document.getElementById(
                    "browseRedirectNow"
                );

                const cancelButton = document.getElementById(
                    "browseRedirectCancel"
                );

                let redirectUrl = null;
                let countdownInterval = null;
                let secondsRemaining = 5;


                // =====================================
                // CLEAR COUNTDOWN
                // =====================================

                function clearCountdown() {

                    if (countdownInterval !== null) {
                        clearInterval(countdownInterval);
                        countdownInterval = null;
                    }

                }


                // =====================================
                // CLOSE MODAL
                // =====================================

                function closeModal() {

                    clearCountdown();

                    modal.classList.remove("is-active");

                    redirectUrl = null;

                }


                // =====================================
                // PERFORM REDIRECT
                // =====================================

                function performRedirect() {

                    if (!redirectUrl) {
                        return;
                    }

                    clearCountdown();

                    window.location.assign(redirectUrl);

                }


                // =====================================
                // OPEN MODAL
                // =====================================

                redirectLinks.forEach(link => {

                    link.addEventListener("click", event => {

                        event.preventDefault();

                        clearCountdown();

                        redirectUrl = link.href;

                        secondsRemaining = 5;

                        countdownElement.textContent = secondsRemaining;

                        modal.classList.add("is-active");

                        countdownInterval = setInterval(() => {

                            secondsRemaining--;

                            countdownElement.textContent = secondsRemaining;

                            if (secondsRemaining <= 0) {
                                performRedirect();
                            }

                        }, 1000);

                    });

                });


                // =====================================
                // GO NOW
                // =====================================

                goNowButton.addEventListener("click", performRedirect);


                // =====================================
                // GO BACK
                // =====================================

                cancelButton.addEventListener("click", closeModal);


                // =====================================
                // CLICK OUTSIDE MODAL
                // =====================================

                modal
                    .querySelector(".modal-background")
                    .addEventListener("click", closeModal);


                // =====================================
                // ESCAPE KEY
                // =====================================

                document.addEventListener("keydown", event => {

                    if (
                        event.key === "Escape" &&
                        modal.classList.contains("is-active")
                    ) {
                        closeModal();
                    }

                });

            });
            </script>
        
        <%- include("../partials/footer") %>
    </body>

</html>